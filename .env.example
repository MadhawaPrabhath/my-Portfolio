# Copy to .env.local (local dev) and/or add in Vercel → Project → Settings → Environment Variables.

# Your deployed URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# ── Contact form: configure ONE provider (or none → mailto fallback) ──

# Formspree (https://formspree.io) — the form ID from https://formspree.io/f/<ID>
NEXT_PUBLIC_FORMSPREE_ID=

# EmailJS (https://www.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
